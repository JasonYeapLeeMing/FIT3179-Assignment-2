{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 270,
  "description": "Mean monthly PBS scripts per resident by SEIFA quintile, 2013-2023.",
  "data": {
    "url": "data/pbs_seifa_annual.csv"
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 45
    },
    "strokeWidth": 2.5
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year"
    },
    "y": {
      "field": "scripts_rate_monthly_mean",
      "type": "quantitative",
      "title": "Mean monthly scripts per resident",
      "scale": {
        "zero": false
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "SEIFA quintile",
      "scale": {
        "domain": [
          "Q1 (most disadvantaged)",
          "Q2",
          "Q3",
          "Q4",
          "Q5 (least disadvantaged)"
        ],
        "range": [
          "#4E79A7",
          "#F28E2B",
          "#B07AA1",
          "#76B7B2",
          "#9C755F"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleOrient": "top"
      }
    },
    "tooltip": [
      {
        "field": "group",
        "type": "nominal",
        "title": "SEIFA quintile"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "scripts_rate_monthly_mean",
        "type": "quantitative",
        "title": "Mean monthly rate",
        "format": ".3f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}

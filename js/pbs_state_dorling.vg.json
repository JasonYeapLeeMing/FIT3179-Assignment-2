{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dorling-style cartogram of mean monthly PBS scripts per resident across Australian states and territories in 2025. Circle area and colour luminance encode prescription rates.",
  "width": 760,
  "height": 560,
  "data": {
    "url": "data/pbs_state_dorling_2025.csv"
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "scale": {
        "domain": [-0.5, 8.7],
        "nice": false
      },
      "axis": null
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "scale": {
        "domain": [-1.5, 6.0],
        "nice": false
      },
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.98,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "size": {
          "field": "scripts_per_erp_monthly_mean",
          "type": "quantitative",
          "title": "Mean monthly PBS prescriptions per resident",
          "scale": {
            "domain": [0, 1.5],
            "range": [600, 22000],
            "clamp": true
          },
          "legend": null
        },
        "color": {
          "field": "scripts_per_erp_monthly_mean",
          "type": "quantitative",
          "title": "Mean monthly PBS prescriptions per resident",
          "scale": {
            "domain": [0.6, 1.35],
            "range": [
              "#D9F3E9",
              "#9ADDC5",
              "#4FBE98",
              "#009E73",
              "#006747"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State/territory"
          },
          {
            "field": "scripts_per_erp_monthly_mean",
            "type": "quantitative",
            "title": "Mean monthly scripts per resident",
            "format": ".3f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontWeight": "bold",
        "fontSize": 17
      },
      "encoding": {
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.scripts_per_erp_monthly_mean < 0.95",
            "value": "#173D32"
          },
          "value": "#FFFFFF"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State/territory"
          },
          {
            "field": "scripts_per_erp_monthly_mean",
            "type": "quantitative",
            "title": "Mean monthly scripts per resident",
            "format": ".3f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "titleFontSize": 13,
      "labelFontSize": 12
    }
  }
}


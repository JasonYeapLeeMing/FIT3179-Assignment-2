{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Historical prevalence of selected health conditions in Australia. ABS NHS Table 1.3.",
  "width": "container",
  "height": 285,
  "data": {
    "url": "data/chronic_conditions.csv"
  },
  "params": [
    {
      "name": "condition",
      "value": "Two or more chronic conditions",
      "bind": {
        "input": "select",
        "options": [
          "At least one chronic condition",
          "Two or more chronic conditions",
          "Arthritis",
          "Asthma",
          "Diabetes",
          "Hay fever / allergic rhinitis",
          "Hypertension",
          "Mental and behavioural conditions"
        ],
        "name": "Health indicator: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.condition === condition"
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 65
    },
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        "2001",
        "2004\u201305",
        "2007\u201308",
        "2011\u201312",
        "2014\u201315",
        "2017\u201318",
        "2022"
      ],
      "axis": {
        "title": "Survey period",
        "titleFontSize": 13,
        "titleFont": "Arial",
        "labelAngle": 0
      }
    },
    "y": {
      "field": "percentage",
      "type": "quantitative",
      "title": "Population (%)",
      "scale": {
        "zero": true
      }
    },
    "tooltip": [
      {
        "field": "condition",
        "title": "Indicator"
      },
      {
        "field": "year",
        "title": "Survey"
      },
      {
        "field": "percentage",
        "title": "Population (%)",
        "format": ".1f"
      }
    ]
  }
}
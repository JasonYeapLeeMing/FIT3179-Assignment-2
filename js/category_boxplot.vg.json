{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Layered boxplots showing monthly PBS prescription rates for six selected ATC Level 1 medicine groups, 2013–2023.",
  "width": "container",
  "height": 390,
  "data": {
    "url": "data/pbs_atc1_monthly.csv"
  },
  "transform": [
    {
      "filter": {
        "field": "group",
        "oneOf": [
          "CARDIOVASCULAR SYSTEM",
          "NERVOUS SYSTEM",
          "ALIMENTARY TRACT AND METABOLISM",
          "ANTIINFECTIVES FOR SYSTEMIC USE",
          "RESPIRATORY SYSTEM",
          "MUSCULO-SKELETAL SYSTEM"
        ]
      }
    },
    {
      "calculate": "datum.group === 'CARDIOVASCULAR SYSTEM' ? 'Cardiovascular' : datum.group === 'NERVOUS SYSTEM' ? 'Nervous system' : datum.group === 'ALIMENTARY TRACT AND METABOLISM' ? 'Alimentary' : datum.group === 'ANTIINFECTIVES FOR SYSTEMIC USE' ? 'Antiinfectives' : datum.group === 'RESPIRATORY SYSTEM' ? 'Respiratory' : 'Musculoskeletal'",
      "as": "group_short"
    }
  ],
  "encoding": {
    "x": {
      "field": "group_short",
      "type": "nominal",
      "title": "Medicine group",
      "sort": [
        "Cardiovascular",
        "Nervous system",
        "Alimentary",
        "Antiinfectives",
        "Respiratory",
        "Musculoskeletal"
      ],
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11,
        "labelLimit": 150,
        "titleFontSize": 12,
        "labelFont": "Arial",
        "titleFont": "Arial"
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "q1",
              "field": "scripts_rate",
              "as": "q1"
            },
            {
              "op": "median",
              "field": "scripts_rate",
              "as": "median"
            },
            {
              "op": "q3",
              "field": "scripts_rate",
              "as": "q3"
            }
          ],
          "groupby": ["group_short"]
        },
        {
          "calculate": "datum.q3 - datum.q1",
          "as": "iqr"
        },
        {
          "calculate": "datum.q1 - 1.5 * datum.iqr",
          "as": "lower_fence"
        },
        {
          "calculate": "datum.q3 + 1.5 * datum.iqr",
          "as": "upper_fence"
        },
        {
          "filter": "datum.scripts_rate >= datum.lower_fence && datum.scripts_rate <= datum.upper_fence"
        },
        {
          "aggregate": [
            {
              "op": "min",
              "field": "scripts_rate",
              "as": "lower_whisker"
            },
            {
              "op": "max",
              "field": "scripts_rate",
              "as": "upper_whisker"
            }
          ],
          "groupby": ["group_short"]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#4C78A8",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "lower_whisker",
          "type": "quantitative",
          "title": "Monthly prescriptions per resident",
          "scale": {
            "zero": true
          },
          "axis": {
            "labelFontSize": 11,
            "titleFontSize": 12,
            "labelFont": "Arial",
            "titleFont": "Arial",
            "format": ".2f"
          }
        },
        "y2": {
          "field": "upper_whisker"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "q1",
              "field": "scripts_rate",
              "as": "q1"
            },
            {
              "op": "median",
              "field": "scripts_rate",
              "as": "median"
            },
            {
              "op": "q3",
              "field": "scripts_rate",
              "as": "q3"
            }
          ],
          "groupby": ["group_short"]
        }
      ],
      "mark": {
        "type": "bar",
        "size": 35,
        "color": "#4C78A8",
        "opacity": 0.95
      },
      "encoding": {
        "y": {
          "field": "q1",
          "type": "quantitative"
        },
        "y2": {
          "field": "q3"
        },
        "tooltip": [
          {
            "field": "group_short",
            "type": "nominal",
            "title": "Medicine group"
          },
          {
            "field": "q1",
            "type": "quantitative",
            "title": "Q1",
            "format": ".3f"
          },
          {
            "field": "median",
            "type": "quantitative",
            "title": "Median",
            "format": ".3f"
          },
          {
            "field": "q3",
            "type": "quantitative",
            "title": "Q3",
            "format": ".3f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "scripts_rate",
              "as": "median"
            }
          ],
          "groupby": ["group_short"]
        }
      ],
      "mark": {
        "type": "tick",
        "color": "white",
        "size": 35,
        "thickness": 2
      },
      "encoding": {
        "y": {
          "field": "median",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "q1",
              "field": "scripts_rate",
              "as": "q1"
            },
            {
              "op": "q3",
              "field": "scripts_rate",
              "as": "q3"
            }
          ],
          "groupby": ["group_short"]
        },
        {
          "calculate": "datum.q3 - datum.q1",
          "as": "iqr"
        },
        {
          "calculate": "datum.q1 - 1.5 * datum.iqr",
          "as": "lower_fence"
        },
        {
          "calculate": "datum.q3 + 1.5 * datum.iqr",
          "as": "upper_fence"
        },
        {
          "filter": "datum.scripts_rate < datum.lower_fence || datum.scripts_rate > datum.upper_fence"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "color": "#E69F00",
        "opacity": 0.8
      },
      "encoding": {
        "y": {
          "field": "scripts_rate",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "group_short",
            "type": "nominal",
            "title": "Medicine group"
          },
          {
            "field": "scripts_rate",
            "type": "quantitative",
            "title": "Monthly prescriptions per resident",
            "format": ".3f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "gridColor": "#E5E7EB",
      "labelColor": "#334155",
      "titleColor": "#0F2740"
    }
  }
}

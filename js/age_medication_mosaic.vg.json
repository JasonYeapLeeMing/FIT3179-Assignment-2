{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "description": "Population-width mosaic of PBS medication type counts by age, ABS National Health Survey 2022 Table 22.3; widths from Table 22.1 estimated populations.",
  "height": 370,
  "data": {
    "url": "data/abs_medication_mosaic_2022.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "x0",
      "type": "quantitative",
      "axis": {
        "title": "Share of population across selected age groups",
        "format": ".0%"
      },
      "scale": {
        "domain": [
          0,
          1
        ]
      }
    },
    "x2": {
      "field": "x1"
    },
    "y": {
      "field": "y0",
      "type": "quantitative",
      "axis": {
        "title": "Within-age-group share",
        "format": ".0%"
      },
      "scale": {
        "domain": [
          0,
          1
        ]
      }
    },
    "y2": {
      "field": "y1"
    },
    "color": {
      "field": "medication_types",
      "type": "nominal",
      "sort": [
        "None",
        "1 type",
        "2–4 types",
        "5–9 types",
        "10+ types"
      ],
      "scale": {
        "domain": [
          "None",
          "1 type",
          "2–4 types",
          "5–9 types",
          "10+ types"
        ],
        "range": [
          "#e4ebf1",
          "#b9d0e0",
          "#7aa7c6",
          "#387da6",
          "#16486e"
        ]
      },
      "legend": {
        "title": "Number of PBS medication types",
        "orient": "bottom"
      }
    },
    "tooltip": [
      {
        "field": "age",
        "title": "Age group"
      },
      {
        "field": "medication_types",
        "title": "Medication types"
      },
      {
        "field": "percentage",
        "title": "Within age group",
        "format": ".1f"
      },
      {
        "field": "population_thousands",
        "title": "Age group population (thousands)",
        "format": ",.1f"
      }
    ]
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mean monthly PBS prescription rates for six selected ATC Level 1 medicine categories, 2013–2023.",
  "width": "container",
  "height": 350,
  "data": {
    "url": "data/pbs_atc1_annual.csv"
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "transform": [
    {
      "filter": {
        "field": "group",
        "oneOf": [
          "CARDIOVASCULAR SYSTEM",
          "NERVOUS SYSTEM",
          "ALIMENTARY TRACT AND METABOLISM",
          "ANTIINFECTIVES FOR SYSTEMIC USE",
          "RESPIRATORY SYSTEM",
          "MUSCULO-SKELETAL SYSTEM"
        ]
      }
    },
    {
      "calculate": "datum.group === 'CARDIOVASCULAR SYSTEM' ? 'Cardiovascular' : datum.group === 'NERVOUS SYSTEM' ? 'Nervous system' : datum.group === 'ALIMENTARY TRACT AND METABOLISM' ? 'Alimentary & metabolism' : datum.group === 'ANTIINFECTIVES FOR SYSTEMIC USE' ? 'Antiinfectives' : datum.group === 'RESPIRATORY SYSTEM' ? 'Respiratory' : 'Musculoskeletal'",
      "as": "category_label"
    }
  ],
  "params": [
    {
      "name": "selected",
      "select": {
        "type": "point",
        "fields": ["category_label"]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 55
    },
    "strokeWidth": 2.8
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "scripts_rate_monthly_mean",
      "type": "quantitative",
      "title": "Mean monthly prescriptions per resident",
      "scale": {
        "zero": true
      }
    },
    "color": {
      "field": "category_label",
      "type": "nominal",
      "title": "Medicine category",
      "scale": {
        "domain": [
          "Cardiovascular",
          "Nervous system",
          "Alimentary & metabolism",
          "Antiinfectives",
          "Respiratory",
          "Musculoskeletal"
        ],
        "range": [
          "#26734D",
          "#A16B4F",
          "#3D78B5",
          "#E28B36",
          "#8064A2",
          "#C76B87"
        ]
      },
      "legend": {
        "orient": "bottom",
        "columns": 3,
        "labelLimit": 200,
        "symbolStrokeWidth": 3
      }
    },
    "opacity": {
      "condition": {
        "param": "selected",
        "value": 1
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "group",
        "title": "Medicine category"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "scripts_rate_monthly_mean",
        "title": "Mean monthly scripts per resident",
        "format": ".3f"
      }
    ]
  }
}

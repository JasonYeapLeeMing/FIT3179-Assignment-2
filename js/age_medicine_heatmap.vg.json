{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "description": "Mean monthly PBS prescriptions per resident by age and medicine group, 2023. AIHW HWE-098 Table 1.",
  "height": 340,
  "data": {
    "url": "data/age_medicine_2023.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "age",
      "type": "ordinal",
      "sort": [
        "0-18",
        "19-64",
        "65+"
      ],
      "title": "Age group"
    },
    "y": {
      "field": "group_short",
      "type": "nominal",
      "sort": [
        "Cardiovascular",
        "Nervous system",
        "Alimentary",
        "Antiinfectives",
        "Respiratory",
        "Musculoskeletal"
      ],
      "title": null
    },
    "color": {
      "field": "scripts_per_resident_monthly_mean",
      "type": "quantitative",
      "title": "Monthly scripts / resident",
      "scale": {
        "scheme": "blues"
      }
    },
    "tooltip": [
      {
        "field": "group",
        "title": "Medicine group"
      },
      {
        "field": "age",
        "title": "Age group"
      },
      {
        "field": "scripts_per_resident_monthly_mean",
        "title": "Monthly scripts / resident (2023 mean)",
        "format": ".3f"
      },
      {
        "field": "months",
        "title": "Months"
      }
    ]
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australian states and territories: 2025 mean monthly PBS scripts per estimated resident (mean of 12 monthly rates).",
  "width": "container",
  "height": 470,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states_2021.topojson.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "transform": [
        {
          "calculate": "{'1':'NSW','2':'VIC','3':'QLD','4':'SA','5':'WA','6':'TAS','7':'NT','8':'ACT'}[datum.properties.STE_CODE21]",
          "as": "state"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/pbs_state_2025.csv"
            },
            "key": "state",
            "fields": [
              "scripts_per_erp_monthly_mean",
              "months_observed"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.75
      },
      "encoding": {
        "color": {
          "field": "scripts_per_erp_monthly_mean",
          "type": "quantitative",
          "title": "Mean monthly perscriptions per resident",
          "scale": {
            "range": [
              "#F8EDF3",
              "#EBC9DB",
              "#CC79A7",
              "#A34C7D",
              "#70244F"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State/territory"
          },
          {
            "field": "scripts_per_erp_monthly_mean",
            "type": "quantitative",
            "format": ".3f",
            "title": "Mean monthly perscriptions per resident"
          },
          {
            "field": "months_observed",
            "type": "quantitative",
            "title": "Months observed"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "WA",
